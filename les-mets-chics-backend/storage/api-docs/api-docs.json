{
    "openapi": "3.0.0",
    "info": {
        "title": "Les Mets Chics API",
        "description": "API REST pour le blog gastronomique Les Mets Chics. Permet la gestion des recettes, catégories, utilisateurs, likes et commentaires.",
        "contact": {
            "name": "Les Mets Chics",
            "email": "admin@lesmetchics.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api",
            "description": "Serveur de développement local"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Inscription d'un nouvel utilisateur",
                "description": "Crée un compte avec role='explorateur' et status='pending'. L'utilisateur doit attendre l'approbation d'un admin.",
                "operationId": "5d4fa5d5607ed675ba93907e1fc94534",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Jean Dupont"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jean@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Inscription réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Inscription réussie. Votre compte est en attente de validation par un administrateur."
                                        },
                                        "user": {
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jean Dupont"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "jean@example.com"
                                                },
                                                "status": {
                                                    "type": "string",
                                                    "example": "pending"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur de validation"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Connexion utilisateur",
                "description": "Authentifie l'utilisateur et retourne un token Sanctum si le compte est actif",
                "operationId": "67d6d0fdd54fba132e1b6f55ca254183",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jean@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Connexion réussie."
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abc123..."
                                        },
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jean Dupont"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "jean@example.com"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "example": "explorateur"
                                                },
                                                "status": {
                                                    "type": "string",
                                                    "example": "active"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Identifiants incorrects"
                    },
                    "403": {
                        "description": "Compte en attente ou suspendu"
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Déconnexion",
                "description": "Révoque le token actuel de l'utilisateur",
                "operationId": "28d48c13fca984400ac8de99f54ee13a",
                "responses": {
                    "200": {
                        "description": "Déconnexion réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Déconnexion réussie."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/user": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Informations utilisateur",
                "description": "Retourne les informations de l'utilisateur authentifié",
                "operationId": "2baab1eeb5fd49516237a38da22e7a07",
                "responses": {
                    "200": {
                        "description": "Informations utilisateur",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "name": {
                                                    "type": "string",
                                                    "example": "Jean Dupont"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "jean@example.com"
                                                },
                                                "role": {
                                                    "type": "string",
                                                    "example": "explorateur"
                                                },
                                                "status": {
                                                    "type": "string",
                                                    "example": "active"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/categories": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Liste des catégories",
                "description": "Retourne toutes les catégories avec le nombre de recettes publiées",
                "operationId": "b1b247b2b491b0491c3c728dc33f23f0",
                "responses": {
                    "200": {
                        "description": "Liste des catégories",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "categories": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "slug": {
                                                        "type": "string"
                                                    },
                                                    "description": {
                                                        "type": "string"
                                                    },
                                                    "recipes_count": {
                                                        "type": "integer"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/categories/{slug}/recipes": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Recettes par catégorie",
                "description": "Retourne toutes les recettes publiées d'une catégorie",
                "operationId": "da161d30fc5941d10c0fe38670e5d22f",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Recettes de la catégorie"
                    },
                    "404": {
                        "description": "Catégorie non trouvée"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/recipes/{slug}/comments": {
            "get": {
                "tags": [
                    "Comments"
                ],
                "summary": "Liste des commentaires",
                "description": "Retourne la liste des commentaires approuvés pour une recette",
                "operationId": "b3929b7c9e719a0d01f2a71614ca20d1",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste des commentaires",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "comments": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer"
                                                    },
                                                    "body": {
                                                        "type": "string"
                                                    },
                                                    "created_at": {
                                                        "type": "string"
                                                    },
                                                    "user": {
                                                        "properties": {
                                                            "name": {
                                                                "type": "string"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Recette non trouvée"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Comments"
                ],
                "summary": "Ajouter un commentaire",
                "description": "Ajoute un commentaire à une recette. Le commentaire doit être approuvé par un admin avant d'être visible.",
                "operationId": "1144ace754a59b3566331b2b0c74859d",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "body"
                                ],
                                "properties": {
                                    "body": {
                                        "type": "string",
                                        "example": "Super recette !"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Commentaire créé",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Commentaire envoyé ! Il sera visible après validation par un administrateur."
                                        },
                                        "comment": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "body": {
                                                    "type": "string"
                                                },
                                                "is_approved": {
                                                    "type": "boolean",
                                                    "example": false
                                                },
                                                "created_at": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur de validation"
                    },
                    "404": {
                        "description": "Recette non trouvée"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/upload/image": {
            "post": {
                "tags": [
                    "Uploads"
                ],
                "summary": "Upload d'image",
                "description": "Upload une image (jpeg, png, jpg, webp) max 5MB",
                "operationId": "8b24439de4ef3c1295260f1916321559",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "image": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Upload réussi",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "url": {
                                            "type": "string",
                                            "example": "http://localhost:8000/storage/uploads/images/xyz.jpg"
                                        },
                                        "path": {
                                            "type": "string",
                                            "example": "uploads/images/xyz.jpg"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur de validation (format ou taille)"
                    },
                    "400": {
                        "description": "Aucun fichier envoyé"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/upload/video": {
            "post": {
                "tags": [
                    "Uploads"
                ],
                "summary": "Upload de vidéo",
                "description": "Upload une vidéo (mp4, mpeg, quicktime) max 50MB",
                "operationId": "f5dc1f57f8149d646ce55323c8de8fe8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "video": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Upload réussi",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "url": {
                                            "type": "string",
                                            "example": "http://localhost:8000/storage/uploads/videos/xyz.mp4"
                                        },
                                        "path": {
                                            "type": "string",
                                            "example": "uploads/videos/xyz.mp4"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erreur de validation (format ou taille)"
                    },
                    "400": {
                        "description": "Aucun fichier envoyé"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/recipes/{slug}/like": {
            "post": {
                "tags": [
                    "Likes"
                ],
                "summary": "Liker/Unliker une recette",
                "description": "Ajoute ou retire un like sur une recette pour l'utilisateur connecté",
                "operationId": "26b8f6910bcdfd53fc69c24766d1f009",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Action réussie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Recette aimée !"
                                        },
                                        "liked": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "likes_count": {
                                            "type": "integer",
                                            "example": 42
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Recette non trouvée"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/recipes/{slug}/like/check": {
            "get": {
                "tags": [
                    "Likes"
                ],
                "summary": "Vérifier le like",
                "description": "Vérifie si l'utilisateur connecté a déjà liké la recette",
                "operationId": "495925240ba7502b4f3a8b0a5be9ec5d",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "État du like",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "liked": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "likes_count": {
                                            "type": "integer",
                                            "example": 42
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Recette non trouvée"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/recipes": {
            "get": {
                "tags": [
                    "Recipes"
                ],
                "summary": "Liste des recettes publiées",
                "description": "Retourne toutes les recettes publiées avec leurs auteurs et catégories. Accessible sans authentification.",
                "operationId": "c8c22c89eaaa570cd6722a3901fed111",
                "responses": {
                    "200": {
                        "description": "Liste des recettes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "recipes": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "title": {
                                                        "type": "string",
                                                        "example": "Coq au Vin"
                                                    },
                                                    "slug": {
                                                        "type": "string",
                                                        "example": "coq-au-vin"
                                                    },
                                                    "description": {
                                                        "type": "string"
                                                    },
                                                    "main_image_url": {
                                                        "type": "string"
                                                    },
                                                    "prep_time": {
                                                        "type": "integer",
                                                        "example": 30
                                                    },
                                                    "cook_time": {
                                                        "type": "integer",
                                                        "example": 120
                                                    },
                                                    "servings": {
                                                        "type": "integer",
                                                        "example": 4
                                                    },
                                                    "author": {
                                                        "properties": {
                                                            "name": {
                                                                "type": "string",
                                                                "example": "Chef Pierre"
                                                            }
                                                        },
                                                        "type": "object"
                                                    },
                                                    "category": {
                                                        "properties": {
                                                            "name": {
                                                                "type": "string",
                                                                "example": "Française"
                                                            },
                                                            "slug": {
                                                                "type": "string",
                                                                "example": "francaise"
                                                            }
                                                        },
                                                        "type": "object"
                                                    },
                                                    "likes_count": {
                                                        "type": "integer",
                                                        "example": 42
                                                    },
                                                    "comments_count": {
                                                        "type": "integer",
                                                        "example": 5
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/recipes/{slug}": {
            "get": {
                "tags": [
                    "Recipes"
                ],
                "summary": "Détails d'une recette",
                "description": "Retourne les détails complets d'une recette incluant vidéo, ingrédients et étapes. Nécessite authentification.",
                "operationId": "f599de9bab2f1b0633cff37c471e9a61",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "description": "Slug de la recette",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "coq-au-vin"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Détails de la recette",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "recipe": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "title": {
                                                    "type": "string"
                                                },
                                                "slug": {
                                                    "type": "string"
                                                },
                                                "description": {
                                                    "type": "string"
                                                },
                                                "main_image_url": {
                                                    "type": "string"
                                                },
                                                "video_url": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "ingredients": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                },
                                                "steps": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                },
                                                "likes_count": {
                                                    "type": "integer"
                                                },
                                                "comments": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Recette non trouvée"
                    },
                    "401": {
                        "description": "Non authentifié"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Utilisez le token obtenu via /login",
                "bearerFormat": "Sanctum Token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Endpoints d'authentification (inscription, connexion, déconnexion)"
        },
        {
            "name": "Recipes",
            "description": "Gestion des recettes gastronomiques"
        },
        {
            "name": "Categories",
            "description": "Gestion des catégories (origines culinaires)"
        },
        {
            "name": "Likes",
            "description": "Système de likes sur les recettes"
        },
        {
            "name": "Comments",
            "description": "Système de commentaires avec modération"
        },
        {
            "name": "Uploads",
            "description": "Uploads"
        }
    ]
}